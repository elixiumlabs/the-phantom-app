# Supabase (Required)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API base URL — empty = same origin (Vercel). Set to http://localhost:3001 for local split dev.
VITE_API_URL=

# Stripe price IDs (must match keys in the backend STRIPE_PRICE_TO_PLAN env var)
VITE_STRIPE_PRICE_PRO_MONTHLY=price_xxx
VITE_STRIPE_PRICE_PRO_ANNUAL=price_xxx
